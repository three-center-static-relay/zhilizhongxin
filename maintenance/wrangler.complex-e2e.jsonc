{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintenance-worker",
  "main": "src/complex-smoke-probe-index.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {"bindings": [{"name": "MAINTENANCE_STATE", "class_name": "MaintenanceState"}]},
  "exports": {"MaintenanceState": {"type": "durable-object", "storage": "sqlite"}},
  "services": [
    {"binding": "ADMIN_CENTER", "service": "admin-worker"},
    {"binding": "GOVERNANCE_CENTER", "service": "governance-worker"},
    {"binding": "INTELLIGENCE_CENTER", "service": "intelligence-worker"},
    {"binding": "COMPUTE_CENTER", "service": "compute-worker"},
    {"binding": "EXPERT_CENTER", "service": "expert-worker"}
  ],
  "observability": {"enabled": true, "logs": {"enabled": true, "head_sampling_rate": 1}}
}
