{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintenance-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {"name": "MAINTENANCE_STATE", "class_name": "MaintenanceState"}
    ]
  },
  "exports": {
    "MaintenanceState": {"type": "durable-object", "storage": "sqlite"}
  },
  "services": [
    {"binding": "GOVERNANCE_CENTER", "service": "governance-worker"},
    {"binding": "INTELLIGENCE_CENTER", "service": "intelligence-worker"},
    {"binding": "COMPUTE_CENTER", "service": "compute-worker"},
    {"binding": "EXPERT_CENTER", "service": "expert-worker"},
    {"binding": "AI_GATEWAY_CONTROL", "service": "admin-worker", "entrypoint": "AIGatewayControl"}
  ],
  "triggers": {"crons": ["*/15 * * * *"]}
}
