{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintenance-worker",
  "main": "src/autonomic-entry.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "ai": {"binding": "AI"},
  "durable_objects": {
    "bindings": [
      {"name": "MAINTENANCE_STATE", "class_name": "MaintenanceState"}
    ]
  },
  "exports": {
    "MaintenanceState": {"type": "durable-object", "storage": "sqlite"}
  },
  "services": [
    {"binding": "GOVERNANCE_CENTER", "service": "governance-worker"},
    {"binding": "INTELLIGENCE_CENTER", "service": "intelligence-worker"},
    {"binding": "COMPUTE_CENTER", "service": "compute-worker"},
    {"binding": "EXPERT_CENTER", "service": "expert-worker"}
  ],
  "vars": {
    "CF_ACCOUNT_ID": "e3aec027af13c557bbcb831d29c1e7b4",
    "AI_GATEWAY_ID": "test",
    "MAINTENANCE_PRIMARY_MODEL": "@cf/nvidia/nemotron-3-120b-a12b",
    "MAINTENANCE_REVIEW_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "MAINTENANCE_COST_MODE": "free-first",
    "MAINTENANCE_AUTO_PAID_BUDGET_USD": "0",
    "MAINTENANCE_MODEL_STRATEGY": "nemotron-primary-three-source-free-first-fallback",
    "EXPERT_MODEL_SOURCE_POLICY": "three-source-cloudflare-free-first",
    "EXPERT_MODEL_SOURCE_CLASSES": "workers-ai,openrouter,huggingface",
    "EXPERT_WORKERS_AI_FREE_ONLY": "true",
    "EXPERT_ROUTE_REFRESH_MINUTES": "15",
    "EXPERT_ROUTE_AUTOMATION_ENABLED": "true",
    "EXPERT_MODEL_ID_PINNING": "false",
    "EXPERT_FUTURE_MODELS_AUTO_DISCOVER": "true"
  },
  "triggers": {"crons": ["*/15 * * * *"]}
}
