{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintenance-worker",
  "main": "src/expert-real-4-seat-probe-index.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    {"binding": "EXPERT_CENTER", "service": "expert-worker"}
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCOUNT_ID": "e3aec027af13c557bbcb831d29c1e7b4",
    "AI_GATEWAY_ID": "test",
    "EXPERT_ROUTE_AUTOMATION_ENABLED": "false"
  },
  "observability": {"enabled": true,"logs":{"enabled":true,"head_sampling_rate":1}}
}
