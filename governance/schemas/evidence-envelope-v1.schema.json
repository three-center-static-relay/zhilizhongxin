{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:three-center:evidence-envelope-v1",
  "title":"Evidence Envelope v1",
  "type":"object",
  "additionalProperties":false,
  "required":["evidence_id","source","version","observed_at","freshness","confidence","jurisdiction","content_digest","provenance"],
  "properties":{
    "evidence_id":{"type":"string","minLength":1,"maxLength":200},
    "source":{"type":"string","minLength":1,"maxLength":300},
    "version":{"type":"string","minLength":1},
    "observed_at":{"type":"string","format":"date-time"},
    "freshness":{"type":"object","required":["score","valid_until"],"properties":{"score":{"type":"number","minimum":0,"maximum":1},"valid_until":{"type":["string","null"],"format":"date-time"}}},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "jurisdiction":{"type":"array","minItems":1,"items":{"type":"string"}},
    "content_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "provenance":{"type":"array","minItems":1,"items":{"type":"object"}}
  }
}
