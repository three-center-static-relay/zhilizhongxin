{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:three-center:capability-abi-v1",
  "title": "Capability ABI v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","type","domain","operations","input_schema","output_schema","provider","protocol","version","auth_scope","permission_scope","network_scope","write_scope","dependencies","substitutes","compatible_with","conflicts_with","cost","latency","throughput","reliability","accuracy","freshness","health","fitness","trust","license","jurisdiction","first_seen","last_verified"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{2,159}$"},
    "type": {"type":"string","enum":["atomic","composite","model","tool","api","dataset","algorithm","resource","workflow"]},
    "domain": {"type":"string","minLength":1},
    "operations": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "input_schema": {"type":"object"}, "output_schema": {"type":"object"},
    "provider": {"type":"string","minLength":1}, "protocol": {"type":"string","minLength":1}, "version": {"type":"string","minLength":1},
    "auth_scope": {"type":"string"}, "permission_scope": {"type":"string"}, "network_scope": {"type":"string"},
    "write_scope": {"type":"string","enum":["none","read","write","destructive"]},
    "dependencies": {"$ref":"#/$defs/stringList"}, "substitutes": {"$ref":"#/$defs/stringList"}, "compatible_with": {"$ref":"#/$defs/stringList"}, "conflicts_with": {"$ref":"#/$defs/stringList"},
    "cost": {"type":"object","required":["class","currency","unit_cost"],"properties":{"class":{"type":"string"},"currency":{"type":"string"},"unit_cost":{"type":"number","minimum":0}}},
    "latency": {"type":"object","required":["class","timeout_ms"],"properties":{"class":{"type":"string"},"timeout_ms":{"type":"number","exclusiveMinimum":0}}},
    "throughput": {"type":"object","required":["class","max_concurrency"],"properties":{"class":{"type":"string"},"max_concurrency":{"type":"integer","minimum":1}}},
    "reliability": {"$ref":"#/$defs/scored"}, "accuracy": {"$ref":"#/$defs/scored"},
    "freshness": {"type":"object","required":["observed_at","ttl_seconds"],"properties":{"observed_at":{"type":"string","format":"date-time"},"ttl_seconds":{"type":"integer","minimum":0}}},
    "health": {"type":"object","required":["status","checked_at"],"properties":{"status":{"type":"string"},"checked_at":{"type":"string","format":"date-time"}}},
    "fitness": {"type":"object","required":["quality","reliability","cost","latency","security","adaptability","complexity"],"additionalProperties":{"type":"number","minimum":0,"maximum":1}},
    "trust": {"type":"object","required":["level","status"],"properties":{"level":{"type":"string","enum":["T0","T1","T2","T3","T4"]},"status":{"type":"string"}}},
    "license": {"type":"string"}, "jurisdiction": {"$ref":"#/$defs/stringList"}, "first_seen": {"type":"string","format":"date-time"}, "last_verified": {"type":"string","format":"date-time"}
  },
  "$defs": {
    "stringList": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "scored": {"type":"object","required":["score","basis"],"properties":{"score":{"type":"number","minimum":0,"maximum":1},"basis":{"type":"string"}}}
  }
}
