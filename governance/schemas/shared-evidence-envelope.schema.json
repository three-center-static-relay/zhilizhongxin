{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://three-center.internal/schemas/shared-evidence-envelope-v1.json",
  "title": "Shared Evidence Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "source", "observed_at", "domain_tags", "payload_type", "provenance", "digest_sha256"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[A-Za-z0-9._:-]+$"},
    "source": {"type": "string", "minLength": 1, "maxLength": 120},
    "source_type": {"type": "string", "maxLength": 80},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "domain_tags": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "capability_tags": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "payload_type": {"type": "string", "enum": ["metric", "timeseries", "table", "entity", "graph", "geospatial", "document-metadata", "model-output", "other"]},
    "geo": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "crs": {"type": "string", "maxLength": 64},
        "geometry_type": {"type": "string", "enum": ["point", "bbox", "polygon", "multipolygon", "h3", "admin", "none"]},
        "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "h3_cells": {"type": "array", "maxItems": 10000, "items": {"type": "string", "maxLength": 32}}
      }
    },
    "quality": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "confidence": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
        "completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "freshness_seconds": {"type": ["number", "null"], "minimum": 0},
        "observed_vs_proxy": {"type": "string", "enum": ["observed", "modeled", "proxy", "synthetic", "mixed", "unknown"]}
      }
    },
    "license": {"type": ["string", "null"], "maxLength": 200},
    "restrictions": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 160}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "retrieval_mode"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 120},
        "operation": {"type": ["string", "null"], "maxLength": 120},
        "retrieval_mode": {"type": "string", "enum": ["live-api", "mcp", "bulk", "local", "derived", "manual"]},
        "source_digest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "parent_evidence_ids": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 180}}
      }
    },
    "payload": {},
    "digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
