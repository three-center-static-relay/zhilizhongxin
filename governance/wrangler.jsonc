{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "governance-worker",
  "main": "src/admin-entry.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "ai": {"binding": "AI"},
  "services": [
    {"binding": "OPENROUTER_RELAY", "service": "expert-worker"},
    {"binding": "INTELLIGENCE_CENTER", "service": "intelligence-worker"},
    {"binding": "COMPUTE_CENTER", "service": "compute-worker"},
    {"binding": "EXPERT_CENTER", "service": "expert-worker"}
  ],
  "durable_objects": {"bindings": [{"name": "ADMIN_STATE", "class_name": "AdminState"}]},
  "exports": {"AdminState": {"type": "durable-object", "storage": "sqlite"}},
  "build": {"command": "node tests/policy-regression.mjs && node tests/policy-hardening-second-layer.mjs && node tests/runtime-attestation.mjs && node tests/openapi-action-schema.mjs && node tests/literature-action-route.mjs && node tests/final-output-validation.mjs && node tests/legacy-action-compat-selftests.mjs && node tests/assist-profile.mjs && node tests/stress.mjs && node tests/admin-gateway-readonly.mjs && node tests/admin-candidate-acceptance.mjs && node tests/admin-candidate-compensation.mjs && node tests/web-gpt-action-snapshot.mjs"},
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
