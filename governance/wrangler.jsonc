{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "governance-worker",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "ai": {"binding": "AI"},
  "services": [
    {"binding": "OPENROUTER_RELAY", "service": "expert-worker"}
  ],
  "build": {"command": "node tests/policy-regression.mjs && node tests/policy-hardening-second-layer.mjs && node tests/final-output-validation.mjs && node tests/assist-profile.mjs && node tests/stress.mjs"},
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
