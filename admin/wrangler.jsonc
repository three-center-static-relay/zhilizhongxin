{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin-worker",
  // Diagnostic-only U1 branch: add version metadata solely to prove 0% admin candidate Version Override identity; never merge.
  "main": "src/production-entry.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "durable_objects": {
    "bindings": [
      {"name": "ADMIN_COORDINATOR", "class_name": "AdminCoordinator"}
    ]
  },
  "exports": {
    "AdminCoordinator": {"type": "durable-object", "storage": "sqlite"}
  },
  "services": [
    {"binding": "GOVERNANCE_CENTER", "service": "governance-worker"},
    {"binding": "INTELLIGENCE_CENTER", "service": "intelligence-worker"},
    {"binding": "COMPUTE_CENTER", "service": "compute-worker"},
    {"binding": "EXPERT_CENTER", "service": "expert-worker"},
    {"binding": "MAINTENANCE_CENTER", "service": "maintenance-worker"},
    {"binding": "AI_GATEWAY_CREDENTIAL_READ", "service": "maintenance-worker", "entrypoint": "AIGatewayCredentialRead"}
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCOUNT_ID": "e3aec027af13c557bbcb831d29c1e7b4",
    "MANAGED_SCRIPTS": "admin-worker,governance-worker,intelligence-worker,compute-worker,expert-worker,maintenance-worker",
    "CENTER_TIMEOUT_MS": "8000",
    "LOCK_TTL_SECONDS": "1800",
    "RATE_LIMIT_PER_MIN": "120",
    "AUTO_PROMOTE": "false",
    "TENCENT_MAKERS_PROJECT_NAME": "python-starter-agent",
    "TENCENT_MAKERS_EXECUTOR_MODE": "auto-discovery"
  }
}
