{
  "openapi": "3.1.0",
  "info": {
    "title": "Three-Center Administration API",
    "version": "2.0.0",
    "description": "Cloudflare administration control plane. Candidate acceptance is fail-closed and bound to the active Worker version."
  },
  "servers": [{"url": "https://admin-worker.a15280020511.workers.dev"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/admin/context": {"get":{"operationId":"getAdminContext","summary":"Get authoritative current admin context","responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/health": {"get":{"operationId":"getSystemHealth","summary":"Get current health of all centers","responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/versions": {"get":{"operationId":"getProductionVersions","summary":"Get Cloudflare Worker versions and deployments","responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/capabilities": {"get":{"operationId":"getAdminCapabilities","summary":"Get admin capabilities and policy gates","responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/quotas": {"get":{"operationId":"getRuntimeQuotas","summary":"Get bounded runtime quotas","responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/audit": {"get":{"operationId":"getAuditSummary","summary":"Get recent redacted admin audit records","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200}}],"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/source/{center}": {"get":{"operationId":"getCenterSource","summary":"Get one center source digest","parameters":[{"name":"center","in":"path","required":true,"schema":{"type":"string","enum":["governance","intelligence","compute","expert","all"]}}],"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/provider/{provider}/readiness": {"get":{"operationId":"getProviderReadiness","summary":"Get intelligence provider readiness","parameters":[{"name":"provider","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/acceptance/{center}/latest": {"get":{"operationId":"getLatestAcceptance","summary":"Get latest acceptance record for a center/all","parameters":[{"name":"center","in":"path","required":true,"schema":{"type":"string","enum":["governance","intelligence","compute","expert","all"]}}],"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/candidate": {"post":{"operationId":"createCandidateVersion","summary":"Register a concrete Cloudflare Worker version as candidate","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["script","version_id"],"properties":{"script":{"type":"string","enum":["admin-worker","governance-worker","intelligence-worker","compute-worker","expert-worker","maintenance-worker"]},"version_id":{"type":"string"},"base_version":{"type":"string"},"change_summary":{"type":"string","maxLength":2000}},"additionalProperties":false}}}},"responses":{"201":{"description":"Candidate created"},"400":{"description":"Bad request"},"401":{"description":"Unauthorized"},"409":{"description":"Version conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/candidate/validate": {"post":{"operationId":"validateCandidate","summary":"Validate the registered candidate and current system health","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/candidate/approve": {"post":{"operationId":"approveCandidate","summary":"Explicitly approve a validated candidate","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/test": {"post":{"operationId":"startAcceptanceTest","summary":"Start candidate-bound runtime acceptance","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"center":{"type":"string","enum":["all","governance","intelligence","compute","expert"],"default":"all"},"suite":{"type":"string","default":"contract"},"request_id":{"type":"string"}},"additionalProperties":false}}}},"responses":{"202":{"description":"Acceptance accepted"},"200":{"description":"Existing idempotent test reused"},"401":{"description":"Unauthorized"},"409":{"description":"Candidate/lock conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/test/{run_id}": {"get":{"operationId":"getAcceptanceTest","summary":"Get acceptance task status","parameters":[{"name":"run_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/task/cancel": {"post":{"operationId":"cancelMaintenanceTask","summary":"Request cancellation of an acceptance task","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["task_id"],"properties":{"task_id":{"type":"string"}},"additionalProperties":false}}}},"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/maintenance/diagnose": {"post":{"operationId":"runMaintenanceDiagnosis","summary":"Run bounded read-only maintenance diagnosis","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/recovery/verify": {"post":{"operationId":"verifyRecoveryState","summary":"Verify post-change health state","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/deploy/promote": {"post":{"operationId":"promoteCandidate","summary":"Accept the already-active candidate only after bound runtime acceptance","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"center":{"type":"string","enum":["all","governance","intelligence","compute","expert"],"default":"all"},"acceptance_run_id":{"type":"string"},"expected_current_version":{"type":"string"}},"additionalProperties":false}}}},"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}},
    "/v1/admin/deploy/rollback": {"post":{"operationId":"rollbackProduction","summary":"Rollback one managed Worker to an explicit or previous version","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["script"],"properties":{"script":{"type":"string","enum":["admin-worker","governance-worker","intelligence-worker","compute-worker","expert-worker","maintenance-worker"]},"expected_current_version":{"type":"string"},"target_version":{"type":"string"},"reason":{"type":"string","maxLength":300}},"additionalProperties":false}}}},"responses":{"200":{"description":"Success"},"401":{"description":"Unauthorized"},"409":{"description":"Conflict"},"500":{"description":"Server error"}}}}
  },
  "components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer"}}}
}
