{
  "openapi": "3.1.0",
  "info": {
    "title": "Three-Center Administration API",
    "version": "2.2.0",
    "description": "Cloudflare administration control plane. Production changes fail closed. The China compute fabric routes verified Tencent, ModelScope, Baidu, Huawei, and Aliyun capabilities through explicit cost and capability gates."
  },
  "servers": [{"url": "https://admin-worker.a15280020511.workers.dev"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/admin/context": {"get": {"operationId": "getAdminContext", "summary": "Get authoritative current admin context", "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/health": {"get": {"operationId": "getSystemHealth", "summary": "Get current health of all centers", "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/versions": {"get": {"operationId": "getProductionVersions", "summary": "Get Cloudflare Worker versions and deployments", "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/capabilities": {"get": {"operationId": "getAdminCapabilities", "summary": "Get admin capabilities and policy gates", "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/quotas": {"get": {"operationId": "getRuntimeQuotas", "summary": "Get bounded runtime quotas", "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/audit": {"get": {"operationId": "getAuditSummary", "summary": "Get recent redacted admin audit records", "parameters": [{"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 200}}], "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/source/{center}": {"get": {"operationId": "getCenterSource", "summary": "Get one center source digest", "parameters": [{"name": "center", "in": "path", "required": true, "schema": {"type": "string", "enum": ["governance", "intelligence", "compute", "expert"]}}], "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/provider/{provider}/readiness": {"get": {"operationId": "getProviderReadiness", "summary": "Get intelligence provider readiness", "parameters": [{"name": "provider", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/acceptance/{center}/latest": {"get": {"operationId": "getLatestAcceptance", "summary": "Get latest acceptance record for a center/all", "parameters": [{"name": "center", "in": "path", "required": true, "schema": {"type": "string", "enum": ["all", "admin", "governance", "intelligence", "compute", "expert", "maintenance"]}}], "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/candidate": {"post": {"operationId": "createCandidateVersion", "summary": "Register active Worker version and rollback base", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["script", "version_id"], "properties": {"script": {"type": "string", "enum": ["admin-worker", "governance-worker", "intelligence-worker", "compute-worker", "expert-worker", "maintenance-worker"]}, "version_id": {"type": "string"}, "base_version": {"type": "string"}, "change_summary": {"type": "string", "maxLength": 2000}}, "additionalProperties": false}}}}, "responses": {"201": {"description": "Candidate created"}, "400": {"description": "Bad request"}, "401": {"description": "Unauthorized"}, "409": {"description": "Version conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/candidate/validate": {"post": {"operationId": "validateCandidate", "summary": "Validate candidate and current system health", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}, "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/candidate/approve": {"post": {"operationId": "approveCandidate", "summary": "Explicitly approve a validated candidate", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}, "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/test": {"post": {"operationId": "startAcceptanceTest", "summary": "Start candidate-bound runtime acceptance", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"center": {"type": "string", "enum": ["all", "admin", "governance", "intelligence", "compute", "expert", "maintenance"], "default": "all"}, "suite": {"type": "string", "default": "contract"}, "request_id": {"type": "string"}}, "additionalProperties": false}}}}, "responses": {"202": {"description": "Acceptance accepted"}, "200": {"description": "Existing idempotent test reused"}, "401": {"description": "Unauthorized"}, "409": {"description": "Candidate/lock conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/test/{run_id}": {"get": {"operationId": "getAcceptanceTest", "summary": "Get acceptance task status", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/task/cancel": {"post": {"operationId": "cancelMaintenanceTask", "summary": "Request cancellation of an acceptance task", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["task_id"], "properties": {"task_id": {"type": "string"}}, "additionalProperties": false}}}}, "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/maintenance/diagnose": {"post": {"operationId": "runMaintenanceDiagnosis", "summary": "Run bounded read-only maintenance diagnosis", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}, "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/recovery/verify": {"post": {"operationId": "verifyRecoveryState", "summary": "Verify post-change health state", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}, "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/deploy/promote": {"post": {"operationId": "promoteCandidate", "summary": "Confirm active candidate after runtime acceptance", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"center": {"type": "string", "enum": ["all", "admin", "governance", "intelligence", "compute", "expert", "maintenance"], "default": "all"}, "acceptance_run_id": {"type": "string"}, "expected_current_version": {"type": "string"}}, "additionalProperties": false}}}}, "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/deploy/rollback": {"post": {"operationId": "rollbackProduction", "summary": "Rollback one managed Worker", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["script"], "properties": {"script": {"type": "string", "enum": ["admin-worker", "governance-worker", "intelligence-worker", "compute-worker", "expert-worker", "maintenance-worker"]}, "expected_current_version": {"type": "string"}, "target_version": {"type": "string"}, "reason": {"type": "string", "maxLength": 300}}, "additionalProperties": false}}}}, "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}, "500": {"description": "Server error"}}}},
    "/v1/admin/selftest": {"post": {"operationId": "runCenterSelftest", "summary": "Run bounded selftest for intelligence, compute, or expert center", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["center"], "properties": {"center": {"type": "string", "enum": ["intelligence", "compute", "expert"]}, "allow_paid": {"type": "boolean", "default": false}}, "additionalProperties": false}}}}, "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "409": {"description": "Confirmation required"}, "500": {"description": "Server error"}}}},
    "/v1/admin/selftest/literature": {"post": {"operationId": "runLiteratureSelftest", "summary": "Run literature production-key selftest", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}, "responses": {"200": {"description": "Success"}, "401": {"description": "Unauthorized"}, "500": {"description": "Server error"}}}},
    "/v1/admin/tencent/status": {"get": {"operationId": "getTencentExecutorStatus", "summary": "Get Tencent EdgeOne executor status", "responses": {"200": {"description": "Ready"}, "401": {"description": "Unauthorized"}, "503": {"description": "Not ready"}}}},
    "/v1/admin/tencent/selftest": {"post": {"operationId": "runTencentExecutorSelftest", "summary": "Run Tencent 15-check executor selftest", "requestBody": {"required": false, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}, "responses": {"200": {"description": "PASS"}, "401": {"description": "Unauthorized"}, "502": {"description": "FAIL"}}}},
    "/v1/admin/tencent/agent": {"post": {"operationId": "runTencentAgent", "summary": "Execute one Tencent EdgeOne agent task", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string", "maxLength": 10000}, "conversation_id": {"type": "string", "maxLength": 36}}, "additionalProperties": false}}}}, "responses": {"200": {"description": "Agent stream"}, "401": {"description": "Unauthorized"}, "503": {"description": "Fail closed"}}}},
    "/v1/admin/compute/fabric/status": {"get": {"operationId": "getChinaComputeFabricStatus", "summary": "Get unified production status for Tencent, ModelScope, Baidu, Huawei, and Aliyun", "parameters": [{"name": "fresh", "in": "query", "required": false, "schema": {"type": "string", "enum": ["0", "1"], "default": "0"}}], "responses": {"200": {"description": "Status returned"}, "401": {"description": "Unauthorized"}, "500": {"description": "Server error"}}}},
    "/v1/admin/compute/fabric/plan": {"post": {"operationId": "planChinaComputeFabric", "summary": "Plan a provider without executing it", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FabricRequest"}}}}, "responses": {"200": {"description": "Plan ready"}, "400": {"description": "Invalid capability/provider"}, "401": {"description": "Unauthorized"}, "503": {"description": "Provider not ready"}}}},
    "/v1/admin/compute/fabric/run": {"post": {"operationId": "runChinaComputeFabric", "summary": "Execute one governed task on the selected China provider", "description": "Tencent may be selected automatically for verified agent/browser/tool scopes. ModelScope is validation-only until a generic business-task adapter is separately verified. Baidu and Huawei require allow_metered=true. Aliyun requires allow_paid=true. No paid fallback is automatic.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FabricRequest"}}}}, "responses": {"200": {"description": "Execution completed or stream started"}, "202": {"description": "Asynchronous validation workflow started"}, "400": {"description": "Invalid request"}, "401": {"description": "Unauthorized"}, "402": {"description": "Paid execution acknowledgement required"}, "409": {"description": "Metered execution acknowledgement required"}, "503": {"description": "Provider not ready"}}}},
    "/v1/admin/compute/fabric/task": {"get": {"operationId": "getChinaComputeFabricTask", "summary": "Get asynchronous fabric task status", "parameters": [{"name": "provider", "in": "query", "required": true, "schema": {"type": "string", "enum": ["modelscope"]}}, {"name": "id", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 100}}], "responses": {"200": {"description": "Task status"}, "400": {"description": "Invalid task"}, "401": {"description": "Unauthorized"}, "404": {"description": "Task not found"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "schemas": {
      "FabricRequest": {
        "type": "object",
        "properties": {
          "capability": {"type": "string", "enum": ["agent", "browser", "tool-agent", "free-cpu-validation", "llm", "functiongraph", "paid-sandbox"]},
          "provider": {"type": "string", "enum": ["tencent", "modelscope", "baidu", "huawei", "aliyun"]},
          "allow_metered": {"type": "boolean", "default": false},
          "allow_paid": {"type": "boolean", "default": false},
          "message": {"type": "string", "maxLength": 10000},
          "conversation_id": {"type": "string", "maxLength": 36},
          "prompt": {"type": "string", "maxLength": 4000},
          "messages": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": true}},
          "model": {"type": "string", "maxLength": 160},
          "max_completion_tokens": {"type": "integer", "minimum": 2, "maximum": 256},
          "temperature": {"type": "number", "minimum": 0.01, "maximum": 1},
          "function_payload": {"type": "object", "additionalProperties": true},
          "payload": {"type": "object", "additionalProperties": true},
          "input": {"type": "object", "additionalProperties": true},
          "op": {"type": "string", "enum": ["python", "shell"]},
          "code": {"type": "string", "maxLength": 8192},
          "command": {"type": "string", "maxLength": 2048},
          "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 60},
          "browser": {"type": "boolean"},
          "url": {"type": "string", "maxLength": 2048}
        },
        "additionalProperties": false
      }
    }
  }
}
